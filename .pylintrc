# Pylint configuration for pe-ppa-package-stats.
#
# This project is a deliberately dependency-light, single-file CLI plus its
# test module.  The limits below reflect the real shape of that design (a few
# large-but-cohesive rendering/scan functions and a single sizeable module)
# and keep `pylint pe_ppa_package_stats.py test_pe_ppa_package_stats.py` at
# 10.00/10 in a reproducible way, while still flagging egregious future growth.

[MESSAGES CONTROL]
# line-too-long:            help text and report literals are intentionally kept
#                           on single lines for readability (the agreed exception).
# import-outside-toplevel:  optional/lazy imports are deliberate -- apt_pkg is an
#                           optional accelerator loaded only in its fallback path,
#                           and tests import helpers locally to keep fixtures close.
disable=
    line-too-long,
    import-outside-toplevel

[FORMAT]
max-module-lines=3000

[DESIGN]
max-args=8
max-positional-arguments=8
max-locals=30
max-returns=13
max-branches=20
max-statements=90
